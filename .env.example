# LP TERMINAL — copy to `.env` in the REPO ROOT (next to package.json).
# Vite reads it via envDir/envPrefix (see vite.config.ts); the indexer reads
# the same file.

# Which chain THIS BUILD serves: `robinhood` or `bsc`. One chain per build —
# the bundle, the indexer catalog and the RPC upstream all follow it, and a
# build serving one chain never reads the other's database. A visitor can still
# be moved by a `?chain=` link; a chain that merely defaulted is never written
# down, so flipping this still moves everyone who never chose.
CHAIN=robinhood

# Private JSON-RPC URL for the chain above, e.g. a provider URL with its key
# path. SECRET: Vite BAKES this into the JS bundle, so set it only for
# personal/local builds. A build you serve publicly must leave RPC unset — it
# then reads through same-origin /rpc, or falls back to the chain's public RPC.
RPC=

# REQUIRED (the build fails without it): address that receives the terminal
# output fee. Use an address you control. (Legacy env name.)
KYBERSWAP_FEE_RECEIVER=

# KyberSwap base for READ-ONLY USD valuation (rewards, APR, simulations).
# MARKET and ZAP never call it, and the app has no Kyber transaction builder.
# Absolute URL = browser calls Kyber directly; a path like /kyber = route
# through your own same-origin reverse proxy, which also switches DexScreener
# and Goldsky onto that origin. Browser-direct calls to those hosts are
# TLS-reset on some restricted networks, which blanks every USD mark.
KYBERSWAP_AGGREGATOR_API_BASE_URL=https://aggregator-api.kyberswap.com

# Swap-solver quote API: cross-venue split routing and a ready-to-sign Settler
# transaction. Defaults to the hosted instance for the selected chain; point it
# at your own if you run one. Leave the chain's solver unset and the swap tab
# quotes direct routes only.
# VITE_SOLVER_URL=

# Optional: serve both chains from one hostname behind a combining proxy. The
# bundle enables the namespaced /_chain/<chain>/* paths only when the runtime
# hostname matches this value exactly, so the same build stays safe elsewhere.
# VITE_CHAIN_GATEWAY_HOST=

# Optional: only WalletConnect QR pairing needs this. Injected wallets
# (MetaMask / Rabby / OKX) work without it. Get one at cloud.walletconnect.com
# VITE_WALLETCONNECT_PROJECT_ID=


# ── Pool indexer (`npm run indexer`) ────────────────────────────────────────
# Server-side only. None of these are exposed to the browser bundle.

# Where the catalog lives, and what port the read API listens on. The database
# is bound to its chain on creation; pointing a `bsc` indexer at a `robinhood`
# database is refused rather than silently merged.
# INDEXER_DB=
# INDEXER_PORT=8787

# Indexer-only RPC endpoints. When PRIMARY is set the indexer uses
# PRIMARY → FALLBACK and never touches the browser-facing RPC, so catalog
# traffic and browser traffic can be rate-limited independently. Every
# configured endpoint's chain id is verified at startup.
# INDEXER_RPC_PRIMARY=
# INDEXER_RPC_FALLBACK=

# REQUIRED FOR `CHAIN=bsc`: BSC's first full V3/V4 catalogs are bootstrapped
# from The Graph, because tailing that history over ordinary RPC is not
# practical. Server-side secret; it is never sent to the browser.
# THEGRAPH_API_KEY=

# BSC also needs at least one indexer endpoint that supports incremental
# `eth_getLogs`. A public endpoint that answers `eth_getLogs` with an empty
# result rather than an error will look healthy and index nothing.

# Optional catch-up tuning. Lower the concurrency if a provider rate-limits a
# sustained backfill.
# INDEXER_BACKFILL_WINDOW_BLOCKS=
# INDEXER_BACKFILL_CONCURRENCY=

# Optional subgraph overrides; each chain config ships a working default.
# INDEXER_V3_SUBGRAPH_ID=
# INDEXER_V4_SUBGRAPH_ID=
# INDEXER_PANCAKE_V3_SUBGRAPH_ID=
