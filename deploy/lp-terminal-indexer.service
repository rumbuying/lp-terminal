[Unit]
Description=LP Terminal pool indexer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lpindexer
Group=lpindexer
WorkingDirectory=/opt/lp-terminal-indexer/app
Environment=NODE_ENV=production
Environment=INDEXER_PORT=8787
Environment=INDEXER_DB=/opt/lp-terminal-indexer/data/index.db
Environment=HOME=/opt/lp-terminal-indexer
Environment=PATH=/opt/node-v22/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/lp-terminal-indexer/app/node_modules/.bin/tsx indexer/main.ts
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/lp-terminal-indexer

[Install]
WantedBy=multi-user.target
